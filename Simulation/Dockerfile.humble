FROM ros:humble

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libeigen3-dev \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    ros-humble-rviz2 \
    tmux \
    && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && rosdep update
# Ubuntu's coverage 6.2 lacks the API required by the simulator's newer Numba.
RUN python3 -m pip install --no-cache-dir "coverage>=7.6" transforms3d

COPY Simulation/f1tenth_gym /tmp/f1tenth_gym
RUN python3 -m pip install --no-cache-dir /tmp/f1tenth_gym \
    && rm -rf /tmp/f1tenth_gym

WORKDIR /sim_ws
COPY Simulation/f1tenth_gym_ros /sim_ws/src/f1tenth_gym_ros
COPY ros_ws/src /sim_ws/src/fiv

RUN apt-get update \
    && source /opt/ros/humble/setup.bash \
    && rosdep install -i --from-path src --rosdistro humble -y \
        --skip-keys "ament_python python-transforms3d-pip" \
    && colcon build --symlink-install \
    && rm -rf /var/lib/apt/lists/*

CMD ["bash"]
